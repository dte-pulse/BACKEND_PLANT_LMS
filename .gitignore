# ── Virtual environments ───────────────────────────────────────
.venv/
venv/
env/
ENV/
.env.bak

# ── Environment variables ──────────────────────────────────────
.env
.env.local
.env.*.local
*.env

# ── Python bytecode ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# ── Distribution / packaging ───────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/
wheels/
pip-wheel-metadata/
share/python-wheels/

# ── Testing & coverage ─────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.coveragerc
nosetests.xml
test-results/
.tox/

# ── Alembic migrations ─────────────────────────────────────────
