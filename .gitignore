alembic/versions/*.pyc
alembic/versions/__pycache__/

# ── Celery ─────────────────────────────────────────────────────
celerybeat-schedule
celerybeat.pid
celery-worker.pid

# ── Logs ───────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ── Local file storage (S3 fallback) ───────────────────────────
uploads/
media/
local_storage/
static_files/

# ── Jupyter / IPython ──────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Editor / IDE ───────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.sw?

# ── OS artefacts ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Type-stubs / mypy ──────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# ── Ruff / linting cache ───────────────────────────────────────
.ruff_cache/

# ── Docker ─────────────────────────────────────────────────────
